NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27018/zaki-chat
CLIENT_ORIGIN=http://localhost:5173

LOG_LEVEL=debug

# Generate each secret with:
# node -e "import('node:crypto').then(c => console.log(c.randomBytes(48).toString('base64url')))"
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me

# Message encryption keys (AES-256-GCM): base64 of EXACTLY 32 random bytes. Generate with:
# node -e "import('node:crypto').then(c => console.log(c.randomBytes(32).toString('base64')))"
# To rotate: add MESSAGE_ENCRYPTION_KEY_V2, then set ACTIVE=2. Never delete old versions
# as long as messages encrypted with them exist.
MESSAGE_ENCRYPTION_KEY_V1=change-me
MESSAGE_ENCRYPTION_KEY_ACTIVE=1

B2_KEY_ID=change-me
B2_APPLICATION_KEY=change-me
B2_BUCKET=change-me
B2_ENDPOINT=change-me
B2_REGION=change-me

# Generate with: npm run generate-vapid
# Required in production; optional in development (push disabled when omitted).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Cloudflare Turnstile Bot & Rotating Proxy Protection
# In development/test, defaults to Cloudflare dummy test key (always passes).
# Required in production when TURNSTILE_ENABLED is true.
TURNSTILE_SECRET_KEY=bc1qpjq2u4vwnyxe3u0flg8hfp3c8mfmd9f38ydu07
TURNSTILE_ENABLED=false
